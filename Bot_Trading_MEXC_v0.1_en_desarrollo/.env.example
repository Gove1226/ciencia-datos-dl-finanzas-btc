# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.
# Las claves viven SOLO en el servidor: ni el frontend ni el LLM las reciben jamás.

# Clave de acceso a la API del bot (la interfaz la pide al entrar). Genere una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"      (o: python scripts/crear_env.py)
APP_API_KEY=
# Clave independiente para la API privada del LLM (/api/llm/consulta)
LLM_API_KEY=

# LLM SOLO LOCAL (Ollama). La URL debe ser loopback; cualquier otro host se rechaza al arrancar.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# MEXC: v0.1 usa SOLO datos públicos (no requiere claves) y simula en papel. Las órdenes reales están deshabilitadas.
MEXC_BASE_URL=https://api.mexc.com
SIMBOLO=BTCUSDT
# Opcionales y NO usadas en v0.1. Si en el futuro se usan, solo en el servidor (permiso de lectura, sin retiros ni trading) y nunca hacia el LLM.
MEXC_API_KEY=
MEXC_SECRET_KEY=

# Rutas opcionales
DB_PATH=agente_datos/agente.db
MODELO_DIR=backend/modelo_aprobado
# Orígenes permitidos para la UI (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
